# ============================================================================
# Copy this file to `.env.local` and fill in the values.
# Without these, the Wallpapers feature falls back to static seed data and the
# /admin area is disabled — the rest of the site works unchanged.
# ============================================================================

# --- Supabase (Project Settings > API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Cloudinary (Dashboard > Settings > API Keys) ---------------------------
# Cloud name is public (used to build delivery URLs in the browser).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
# Secret stays server-side only — never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=your-api-secret

# --- AI Assistant (Gemini API) -----------------------------------------------
# Get your free key from aistudio.google.com. Server-only — never NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
